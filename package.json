{
  "name": "freshman-campus-ai-admin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "student-mobile"
  ],
  "scripts": {
    "twin:prepare": "node scripts/build-twin-viewer.mjs",
    "test:twin": "npm run twin:prepare && node --test scripts/tests/twin-viewer.test.mjs && playwright test --config playwright.twin.config.ts",
    "predev": "npm run twin:prepare",
    "prebuild": "npm run twin:prepare",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "mvn -f server/pom.xml spring-boot:run",
    "test:server": "mvn -f server/pom.xml test",
    "test:workspace": "playwright test --config playwright.workspace.config.ts",
    "dev:mobile": "npm --workspace student-mobile run start",
    "dev:mobile:tunnel": "npm --workspace student-mobile run start:tunnel",
    "check:mobile": "npm --workspace student-mobile run typecheck",
    "build:mobile": "npm --workspace student-mobile run export"
  },
  "dependencies": {
    "@playcanvas/supersplat-viewer": "1.28.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
